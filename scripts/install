#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
binary=${1:-target/release/hundred}
if revision=$(git --no-replace-objects rev-parse --verify 'HEAD^{commit}' 2>/dev/null); then
  : # The checked revision takes precedence over an archive build override.
elif [[ -n ${HUNDRED_BUILD_SHA:-} ]]; then
  revision=$HUNDRED_BUILD_SHA
else
  echo 'No Git revision is available; set HUNDRED_BUILD_SHA when building and installing a source archive.' >&2
  exit 1
fi
version=$("$binary" --version)
printf '%s\n' "$version"
if [[ $version =~ ^hundred[[:space:]][^[:space:]]+[[:space:]]\(([^()[:space:]]+)\)$ ]] && [[ ${BASH_REMATCH[1]} == "$revision" ]]; then
  :
else
  echo 'Binary revision differs from the expected revision; build or select the matching release.' >&2
  exit 1
fi
install -d -m 0755 "$HOME/.local/lib/hundred" "$HOME/.local/bin" "$HOME/.local/share/applications"
install -m 0755 "$binary" "$HOME/.local/lib/hundred/hundred.next"
mv "$HOME/.local/lib/hundred/hundred.next" "$HOME/.local/lib/hundred/hundred"
# Pass keeps the credential; the launcher also works when it cannot be opened.
install -m 0755 scripts/launcher "$HOME/.local/bin/hundred.next"
mv "$HOME/.local/bin/hundred.next" "$HOME/.local/bin/hundred"
printf '[Desktop Entry]\nType=Application\nName=Hundred\nComment=Log a set. A little more colour, every day.\nExec=%s/.local/bin/hundred\nIcon=hundred\nTerminal=false\nCategories=Utility;Sports;\nStartupWMClass=io.mistystep.hundred\n' "$HOME" > "$HOME/.local/share/applications/io.mistystep.hundred.desktop"
install -d "$HOME/.local/share/icons/hicolor/scalable/apps"
install -m 0644 assets/hundred.svg "$HOME/.local/share/icons/hicolor/scalable/apps/hundred.svg"
echo 'Installed Hundred. No startup service or global shortcut was changed.'
